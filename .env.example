# GEMMA AI Configuration (Section 5)
# Set your self-hosted or provider Gemma endpoint (e.g. HuggingFace, vLLM, Ollama, OpenRouter, Vertex AI)
GEMMA_API_URL=""
GEMMA_API_KEY=""
GEMMA_MODEL_ID="gemma-2-9b-it"

# GEMINI AI Configuration (Alternative Provider)
# AI Studio automatically injects this at runtime when available.
GEMINI_API_KEY=""

# EXTERNAL SEARCH PROVIDER (Source B - Authorized Search APIs)
# e.g., Google Custom Search API, Serper, SerpAPI, or retailer discovery endpoints
EXTERNAL_SEARCH_API_URL=""
EXTERNAL_SEARCH_API_KEY=""

# Application Host URL
APP_URL="http://localhost:3000"
PORT=3000

